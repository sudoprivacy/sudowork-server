# ============================================
# Sudowork-Server Environment Configuration
# Copy this file to .env and configure values
# ============================================

# --------------------------------------------
# Redis Configuration
# --------------------------------------------
# Redis host (use 'redis' for docker-compose)
REDIS_HOST=redis
# Redis port
REDIS_PORT=6379
# Redis password (leave empty if no password)
REDIS_PASSWORD=

# --------------------------------------------
# Database Configuration
# --------------------------------------------
# SQLite database file path
DB_PATH=/app/data/sudowork.db

# Shared PostgreSQL / TimescaleDB connection
# Used by QMS telemetry now and available for future sudowork-server modules.
PG_DB_HOST=postgres
PG_DB_PORT=5432
PG_DB_NAME=sudowork
PG_DB_USER=postgres
PG_DB_PASSWORD=
PG_DB_MAX_CONNECTIONS=20

# Upload directory for config item icons
UPLOAD_DIR=/app/data/uploads

# --------------------------------------------
# Server Configuration
# --------------------------------------------
# Server port
SERVER_PORT=3000

# --------------------------------------------
# Security Configuration (REQUIRED)
# --------------------------------------------
# JWT secret key (REQUIRED in production)
# Generate a strong random string: openssl rand -hex 32
JWT_SECRET=

# Super Admin Credentials (REQUIRED for initial setup)
# Super admin login phone/username
SUPER_ADMIN_PHONE=sudo
# Super admin login password (REQUIRED, change this in production!)
SUPER_ADMIN_PASSWORD=

# --------------------------------------------
# SMS Provider Configuration
# --------------------------------------------
# SMS provider: 'mock' for testing, 'tencent' for production
SMS_PROVIDER=mock

# Tencent Cloud SMS Credentials (required if SMS_PROVIDER=tencent)
# Get these from: https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# Tencent Cloud SMS Settings
# Get SDK App ID from: https://console.cloud.tencent.com/smsv2
TENCENT_SDK_APP_ID=
# SMS signature name (must be approved)
TENCENT_SIGN_NAME=
# SMS template ID (must be approved)
TENCENT_TEMPLATE_ID=
# SMS signature ID (optional)
TENCENT_SIGN_ID=
# Tencent Cloud region
TENCENT_REGION=ap-beijing

# --------------------------------------------
# Verification Code Configuration (Phone-level)
# --------------------------------------------
# Verification code length (4 or 6 digits)
SMS_CODE_LENGTH=6
# Verification code expiration time (minutes)
SMS_CODE_EXPIRE_MINUTES=5
# Minimum interval between sending codes (seconds)
SMS_CODE_SEND_INTERVAL=60
# Maximum number of codes per day per phone
SMS_CODE_MAX_PER_DAY=10

# --------------------------------------------
# Rate Limiting Configuration (IP-level)
# --------------------------------------------
# Enable rate limiting
RATE_LIMIT_ENABLED=true
# Login rate limit: time window in milliseconds (default: 15 minutes)
RATE_LIMIT_LOGIN_WINDOW_MS=900000
# Login rate limit: max requests per IP per window
RATE_LIMIT_LOGIN_MAX=10
# API rate limit: time window in milliseconds (default: 1 minute)
RATE_LIMIT_API_WINDOW_MS=60000
# API rate limit: max requests per IP per window
RATE_LIMIT_API_MAX=100

# --------------------------------------------
# Sudorouter Configuration
# --------------------------------------------
# Sudorouter API base URL
SUDOROUTER_BASE_URL=http://10.0.1.8:3000
# Sudorouter API token
SUDOROUTER_API_TOKEN=
# Sudorouter admin user ID
SUDOROUTER_ADMIN_USER_ID=13
# Sudorouter request timeout (milliseconds)
SUDOROUTER_TIMEOUT_MS=10000
# Sudorouter model service URL
SUDOROUTER_MODEL_SERVICE_URL=http://10.0.1.8:3000/v1
# Sudorouter models API URL
SUDOROUTER_MODELS_API_URL=https://chat.sudorouter.ai/api/specific_pricing

# --------------------------------------------
# Skillhub Configuration
# --------------------------------------------
# Skillhub API base URL
SKILLHUB_BASE_URL=http://10.0.1.9:3000
# Skillhub API auth token (转发请求的 Authorization 值)
SKILLHUB_API_TOKEN=SKILL_HUB_TOKEN

# --------------------------------------------
# User Configuration
# --------------------------------------------
# Initial quota for new users (default: 500000 = 1000 points)
USER_INITIAL_QUOTA=500000

# --------------------------------------------
# Fuiou Payment Configuration (富友支付)
# --------------------------------------------
# Enable test mode (true for testing, false for production)
FUIOU_TEST_MODE=false

# Merchant code (商户代码)
# Test: 
# Production: 
FUIOU_MERCHANT_CODE=

# --------------------------------------------
# Merchant Private Key (商户私钥) - Choose ONE method:
# --------------------------------------------
# Method 1: Raw Base64 string (from Fuiou docs, recommended for testing)
FUIOU_MERCHANT_PRIVATE_KEY=

# Method 2: PEM format string (with headers)
# FUIOU_MERCHANT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIICdQIBADAN...\n-----END PRIVATE KEY-----

# Method 3: File path (recommended for production)
# FUIOU_MERCHANT_PRIVATE_KEY_FILE=/app/secrets/fuiou_private_key.pem

# --------------------------------------------
# Fuiou Public Key (富友公钥) - Choose ONE method:
# --------------------------------------------
# Method 1: Raw Base64 string (from Fuiou docs, recommended for testing)
FUIOU_PUBLIC_KEY=

# Method 2: PEM format string (with headers)
# FUIOU_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIGfMA0GCSqGSIb...\n-----END PUBLIC KEY-----

# Method 3: File path (recommended for production)
# FUIOU_PUBLIC_KEY_FILE=/app/secrets/fuiou_public_key.pem

# Request timeout in milliseconds
FUIOU_TIMEOUT_MS=10000

# Fuiou API URLs (optional, defaults provided)
# Test environment API URL
FUIOU_TEST_API_URL=https://hlwnets-test.fuioupay.com
# Production environment API URL
FUIOU_PROD_API_URL=https://hlwnets.fuioupay.com

# Server URL for callback (服务器地址，用于回调)
SERVER_URL=http://localhost:3000

# Recharge configuration
# Minimum recharge amount in USD
RECHARGE_MIN_AMOUNT=1
# Order expiration time in minutes
RECHARGE_ORDER_EXPIRE_MINUTES=30

# USD to CNY exchange rate (美元转人民币汇率)
USD_TO_CNY_RATE=7.3

# --------------------------------------------
# QMS / Telemetry Configuration
# --------------------------------------------
# Set to true to enable QMS routes and background workers
QMS_ENABLED=true

# QMS uses the shared Redis connection above and stores queue data under this prefix.
QMS_REDIS_KEY_PREFIX=qms:

# Telemetry ingestion API key. Sudowork clients keep sending this header.
QMS_API_KEY_HEADER=X-API-Key
# Must match the Sudowork client QMS API key during the compatibility period.
QMS_DEFAULT_API_KEY=

# Optional hybrid encryption for telemetry/crash payloads
QMS_TELEMETRY_PRIVATE_KEY=
QMS_TELEMETRY_PUBLIC_KEY=
QMS_TELEMETRY_ENCRYPTION_REQUIRED=false
QMS_TELEMETRY_ENCRYPTION_ALGORITHM=hybrid-v1

# QMS background tasks
QMS_QUEUE_FLUSH_INTERVAL=3000
QMS_QUEUE_BATCH_SIZE=100
QMS_PERF_RETENTION_DAYS=90
QMS_CONVERSATION_RETENTION_DAYS=180

# QMS notifications
QMS_LARK_WEBHOOK_URL=
QMS_EMAIL_SMTP_HOST=
QMS_EMAIL_SMTP_PORT=587
QMS_EMAIL_SMTP_SECURE=false
QMS_EMAIL_SMTP_USER=
QMS_EMAIL_SMTP_PASS=
QMS_EMAIL_FROM=
QMS_EMAIL_TO=

# --------------------------------------------
# Dify Integration (RAG + Agent)
# --------------------------------------------
# Internal URL to the patched Dify api service. From sudowork-server's POV.
# Default is the docker-compose service name when both run on the same network.
DIFY_BASE_URL=http://dify-api:5001

# HS256 secret shared with Dify SUDOWORK_SSO_SECRET.
# Used to sign the 5-minute SSO JWT carried by the admin browser.
# Generate with: openssl rand -base64 48
DIFY_SSO_SECRET=

# HMAC-SHA256 secret shared with Dify SUDOWORK_SYSTEM_SECRET.
# Protects the tenant-provisioning bootstrap call.
# Generate with: openssl rand -base64 48
DIFY_SYSTEM_SECRET=

# Long-lived bearer accepted by Dify's /sudowork/system/* endpoints.
# Generate with: openssl rand -base64 64
DIFY_SYSTEM_TOKEN=
